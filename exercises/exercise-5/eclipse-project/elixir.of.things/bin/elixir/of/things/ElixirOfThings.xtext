grammar elixir.of.things.ElixirOfThings with org.eclipse.xtext.common.Terminals

generate elixirOfThings "http://www.of.elixir/things/ElixirOfThings"

System:
    'system' name=ID '{'
        broker=Broker
        nodes+=Node+
        topics+=Topic*
        (sensors+=Sensor | actuators+=Actuator | coordinators+=Coordinator)*
    '}';

Broker:
    'broker:' host=STRING 'port:' port=INT;

Node:
    'node' name=ID;

Topic:
    'topic' name=ID '=' '(' topicString=STRING ',' qos=QoS ')';

Sensor:
    'sensor' name=ID '{'
        'type:' type=SensorType
        'gpioPin:' gpioPin=INT
        'sampleRate:' sampleRate=SampleRate
        'deployedOn:' deployedOn=[Node]
        triggers+=Trigger*
    '}';

SampleRate:
    value=NumExpr unit=TimeUnit;

NumExpr returns NumExpr:
    NumMul (
        ({NumAddExpr.left=current} '+' | {NumSubExpr.left=current} '-')
        right=NumMul
    )*;

NumMul returns NumExpr:
    NumAtom (
        ({NumMulExpr.left=current} '*' | {NumDivExpr.left=current} '/')
        right=NumAtom
    )*;

NumAtom returns NumExpr:
    {NumLiteral} value=INT |
    '(' NumExpr ')';

Trigger:
    'trigger' name=ID '{'
        condition=TriggerCondition
        actions+=TriggerAction+
    '}';

TriggerCondition:
    'when' 'value' operator=Operator right=NumExpr ':';

TriggerAction:
    'publish' topic=[Topic] ':' '{' fields+=PublishField (',' fields+=PublishField)* '}';

PublishField:
    {ValueField}     'value'     |
    {TimestampField} 'timestamp';

Actuator:
    'actuator' name=ID '{'
        'type:' type=ActuatorType
        'gpioPin:' gpioPin=INT
        'deployedOn:' deployedOn=[Node]
        'subscribeTo:' subscribeTo+=[Topic] (',' subscribeTo+=[Topic])*
        messages+=OnMessage*
    '}';

OnMessage:
    'on' 'message' 'from' topic=[Topic] ':'
        'turn' state=State ('for' duration=SampleRate)?;

Coordinator:
    'coordinator' name=ID '{'
        'deployedOn:' deployedOn=[Node]
        'subscribeTo:' subscribeTo+=[Topic] (',' subscribeTo+=[Topic])*
        rules+=Rule*
    '}';

Rule:
    'rule' name=ID '{'
        condition=RuleCondition
        actions+=RuleAction+
    '}';

RuleCondition:
    'when' expression=BoolOr ':';

BoolOr returns BoolExpr:
    BoolAnd ({BoolOrExpr.left=current} 'or' right=BoolAnd)*;

BoolAnd returns BoolExpr:
    BoolNot ({BoolAndExpr.left=current} 'and' right=BoolNot)*;

BoolNot returns BoolExpr:
    {BoolNotExpr} 'not' operand=BoolAtom |
    BoolAtom;

BoolAtom returns BoolExpr:
    {TopicRef} topic=[Topic] |
    '(' BoolOr ')';

RuleAction:
    'publish' topic=[Topic] ':' '{' ('message:' message=STRING)? '}';

enum SensorType:
    TEMP_DS18B20 | TEMP_DHT22 | HUMIDITY | MOTION_PIR | LIGHT | DISTANCE;

enum ActuatorType:
    RELAY | LED | BUZZER | SERVO;

enum QoS:
    AT_MOST_ONCE | AT_LEAST_ONCE | EXACTLY_ONCE;

enum Operator:
    GREATER_THAN='>' | LESS_THAN='<' | GREATER_EQ='>=' | LESS_EQ='<=' | EQUALS='==';

enum State:
    ON | OFF;

enum TimeUnit:
    SEC='sec' | MIN='min' | MS='ms';
